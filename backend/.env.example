# ========================================================
# POP CARTY - BACKEND SERVICE ENVIRONMENT VARIABLES
# ========================================================
PORT=3000
NODE_ENV=production

# CORS allowed origins (comma separated or * for any)
FRONTEND_URL=https://your-popcarty-store.vercel.app,http://localhost:3000

# JWT & Session Secret
JWT_SECRET=popcarty_ultra_secure_production_secret_2026

# Production Managed PostgreSQL Database
DATABASE_URL=postgresql://user:password@ep-sample-host.us-east-2.aws.neon.tech/popcarty?sslmode=require

# Local SQLite fallback (used only if DATABASE_URL is unset)
DATABASE_PATH=./data/popcarty.db

# Super Admin Initial Account
DEFAULT_ADMIN_EMAIL=admin@popcarty.com
DEFAULT_ADMIN_PASSWORD=PopCarty@2026!

# Payment Gateway Configuration (Optional)
PAYMENT_GATEWAY_PROVIDER=mock_mada
PAYMENT_GATEWAY_KEY=pk_live_your_payment_key_here
PAYMENT_GATEWAY_SECRET=sk_live_your_payment_secret_here

# AI Image-to-3D Generation Engine (Optional - Meshy API https://meshy.ai)
MESHY_API_KEY=
TRIPO_API_KEY=
