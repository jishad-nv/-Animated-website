# ========================================================
# POP CARTY - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and fill in your actual production values.
# NEVER commit your real .env file with production secrets.
# ========================================================

# ========================================================
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel)
# ========================================================
# Base URL of the backend API service (e.g. deployed on Render, Railway, Fly.io)
# Leave empty if running on same origin or using Vercel rewrites.
VITE_API_URL=https://popcarty-backend.onrender.com

# ========================================================
# 2. BACKEND ENVIRONMENT VARIABLES (Render / Railway / Node Service)
# ========================================================
# Server Port
PORT=3000
NODE_ENV=production

# Frontend Origin for CORS (comma-separated for multiple domains, or * for all)
FRONTEND_URL=https://your-popcarty-store.vercel.app,http://localhost:3000

# Cryptographically Secure JWT Secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string

# Database Configuration:
# PRODUCTION (Managed PostgreSQL - Neon, Supabase, Render, Railway, AWS RDS):
DATABASE_URL=postgresql://user:password@ep-sample-host.us-east-2.aws.neon.tech/popcarty?sslmode=require

# DEVELOPMENT / LOCAL FALLBACK:
# If DATABASE_URL is left unset, backend automatically falls back to local SQLite
DATABASE_PATH=./data/popcarty.db

# Super Admin Initial Account (seeded if users table is empty)
DEFAULT_ADMIN_EMAIL=admin@popcarty.com
DEFAULT_ADMIN_PASSWORD=PopCarty@2026!

# Payment Gateway Configuration (Optional)
PAYMENT_GATEWAY_PROVIDER=mock_mada
PAYMENT_GATEWAY_KEY=pk_live_your_payment_key_here
PAYMENT_GATEWAY_SECRET=sk_live_your_payment_secret_here

# AI Image-to-3D Generation Engine (Optional - Meshy API https://meshy.ai)
MESHY_API_KEY=
TRIPO_API_KEY=
