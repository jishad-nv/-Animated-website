# Pop Carty Environment Configuration
PORT=3000
NODE_ENV=production

# JWT & Session Secret (replace with your secure 64-character random string)
JWT_SECRET=popcarty_ultra_secure_production_secret_2026

# Database Path (default uses local SQLite WAL database in data/popcarty.db)
DATABASE_PATH=./data/popcarty.db

# Default Super Admin Credentials (auto-seeded if users table is empty)
DEFAULT_ADMIN_EMAIL=admin@popcarty.com
DEFAULT_ADMIN_PASSWORD=PopCarty@2026!

# Payment Gateway Configuration (Optional - set when connecting Stripe/Tap/Mada)
PAYMENT_GATEWAY_PROVIDER=mock_mada
PAYMENT_GATEWAY_KEY=pk_live_your_payment_key_here
PAYMENT_GATEWAY_SECRET=sk_live_your_payment_secret_here

# AI Image-to-3D Generation (Optional - set for Cloud AI generation)
# Primary engine: Meshy API (https://meshy.ai)
MESHY_API_KEY=
# Secondary engine: Tripo3D API (https://tripo3d.ai)
TRIPO_API_KEY=

